# Base URL của backend API khi chạy admin ở dev.
# '/api' = đi qua Vite proxy tới backend local (xem VITE_API_TARGET).
# Nhờ vậy admin dev và client dev cùng nói chuyện với 1 backend, và các
# thay đổi server mới được kiểm tra ngay mà không cần deploy.
VITE_API_URL=/api

# Target của Vite proxy (chỉ dùng ở dev).
# Phải khớp với PORT trong server/.env.
VITE_API_TARGET=http://localhost:9007

# Domain client để admin dùng khi cần link ra trang public.
VITE_CLIENT_URL=https://tungviet.fun

# Muốn admin dev gọi production API thay vì backend local:
#   đổi VITE_API_URL=https://tungviet.fun/api
