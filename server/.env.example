# Server Configuration
PORT=5000
NODE_ENV=development

# Logging (trace|debug|info|warn|error|fatal)
# Ở production nên để "warn" để không ghi log từng request (giảm tải I/O).
LOG_LEVEL=info

# MongoDB
MONGODB_URI=mongodb://localhost:27017/tungviet

# JWT
# IMPORTANT: phai dung JWT_EXPIRES_IN (khong phai JWT_EXPIRE) de khop voi code
# Bắt buộc >= 32 ký tự ngẫu nhiên. Sinh bằng:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=your-secret-key-here-at-least-32-characters-long
JWT_EXPIRES_IN=7d

# Client URLs (for CORS whitelist - se duoc su dung o giai doan sau)
# Nhiều origin thì phân cách bằng dấu phẩy, KHÔNG thêm dấu / cuối.
CLIENT_URL=http://localhost:3000
ADMIN_URL=http://localhost:3001
# Thêm origin khác (domain thật của bạn), phân cách bằng dấu phẩy
EXTRA_ORIGINS=

# Rate limit
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=300
# Giới hạn riêng cho đăng nhập/đăng ký (chống brute-force)
AUTH_RATE_LIMIT_MAX=20

# Analytics — chống CPU 100% do bot quét site
# Ghi log visit: mỗi IP tối đa 1 lần / VISIT_LOG_MIN_INTERVAL_MS
VISIT_LOG_MIN_INTERVAL_MS=60000
# Tần suất lookup ip-api.com (ms) — không gọi ra ngoài thường xuyên
GEO_LOOKUP_INTERVAL_MS=1000
# Chu kỳ dựng lại snapshot "người dùng online" (ms)
ONLINE_SNAPSHOT_INTERVAL_MS=30000
# Giữ log visit bao nhiêu ngày (cron cleanup + TTL index)
VISIT_LOG_RETENTION_DAYS=90
# Cron dọn log cũ (24h format)
CLEANUP_CRON=0 3 * * *

# Public base URL dung de build URL tuyet doi cho anh upload (logo, slides, products...)
PUBLIC_BASE_URL=https://tungviet.fun

# Cho phép xem Swagger UI ở production (mặc định tắt).
# Khi bật, /api/docs public; /api/openapi.json vẫn cần token hợp lệ.
ENABLE_API_DOCS=false
