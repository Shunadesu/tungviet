# Server Configuration
PORT=5000
NODE_ENV=development

# Logging (trace|debug|info|warn|error|fatal)
LOG_LEVEL=info

# MongoDB
MONGODB_URI=mongodb://localhost:27017/tungviet

# JWT
# IMPORTANT: phai dung JWT_EXPIRES_IN (khong phai JWT_EXPIRE) de khop voi code
JWT_SECRET=your-secret-key-here
JWT_EXPIRES_IN=7d

# Client URLs (for CORS whitelist - se duoc su dung o giai doan sau)
CLIENT_URL=http://localhost:3000
ADMIN_URL=http://localhost:3001

# Public base URL dung de build URL tuyet doi cho anh upload (logo, slides, products...)
PUBLIC_BASE_URL=https://tungviet.fun